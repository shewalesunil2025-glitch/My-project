# ---------------------------------------------------------------------------
# Veer Cinema — environment variables (all are PUBLIC, browser-exposed values)
# Never put service_role keys or payment secrets here.
# ---------------------------------------------------------------------------

# Leave both Supabase values empty to run in DEMO MODE (data lives in the
# browser's localStorage and is seeded automatically).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Storage bucket that holds movie posters (Supabase mode only)
VITE_SUPABASE_POSTER_BUCKET=posters

# Canonical site URL used in Open Graph tags
VITE_SITE_URL=http://localhost:5173
