# Public site URL used for canonical links, sitemap and Open Graph
NEXT_PUBLIC_SITE_URL=https://ibaxai.com

# Optional: external booking page (Calendly, Cal.com…). When set, "Book a Free Demo" opens it.
NEXT_PUBLIC_BOOKING_URL=

# Optional: webhook (n8n, Make, Zapier, CRM) for /api/lead. Without it, leads are emailed to LEAD_EMAIL via FormSubmit
LEAD_WEBHOOK_URL=

# Optional: smarter IBAX answers from Claude via /api/shambhu. Without it IBAX uses free mode
ANTHROPIC_API_KEY=

# Where contact-form emails go (default: the site contact email)
LEAD_EMAIL=
