# Public site URL used for canonical links, sitemap and Open Graph
NEXT_PUBLIC_SITE_URL=https://www.munnaai.com

# Optional: external booking page (Calendly, Cal.com…). When set, "Book a Free Demo" opens it.
NEXT_PUBLIC_BOOKING_URL=

# Optional: webhook (n8n, Make, Zapier, CRM) that receives demo requests from /api/lead
LEAD_WEBHOOK_URL=
# Gmail + Google App password: emails demo / call-back requests to the owner
SMTP_USER=
SMTP_PASS=

# Optional: smarter Shambhu answers from Claude via /api/shambhu. Without it Shambhu uses free mode and
# the Lumi app assistant (/api/assistant) answers from workspace data with built-in responses.
ANTHROPIC_API_KEY=

# WhatsApp official (Meta Cloud API, Embedded Signup). See docs/ROADMAP.md.
NEXT_PUBLIC_META_APP_ID=
NEXT_PUBLIC_META_WA_CONFIG_ID=
# 1 once Meta approves the app (App Review); before that only /app/settings?meta=1 shows the button
NEXT_PUBLIC_META_WA_LIVE=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
